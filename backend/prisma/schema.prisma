datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERVISOR
  AGENT
  CUSTOMER
}

enum UserStatus {
  PENDING_SETUP
  ACTIVE
  SUSPENDED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Category {
  BUG
  BILLING
  FEATURE
  QUESTION
  ACCOUNT
  INTEGRATION
  PERFORMANCE
  SECURITY
  ONBOARDING
  OTHER
}

enum Status {
  NEW
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum AuthorType {
  AGENT
  CUSTOMER
  SYSTEM
}

enum AuditEventType {
  TICKET_CREATED
  STATUS_CHANGED
  REASSIGNED
  COLLABORATOR_ADDED
  COLLABORATOR_REMOVED
  REPLY_ADDED
  TICKET_EDITED
  TICKET_ARCHIVED
  TICKET_RESTORED
  SLA_ALERT_ACKNOWLEDGED
  CSAT_SUBMITTED
  TAG_ADDED
  TAG_REMOVED
}

enum DigestFrequency {
  DAILY
  WEEKLY
  NEVER
}

enum SlaAlertType {
  DUE_SOON
  BREACHED
}

enum SlaAlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(AGENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  createdTickets         Ticket[]                 @relation("TicketCreator")
  requestedTickets       Ticket[]                 @relation("TicketRequester")
  assignedTickets        Ticket[]                 @relation("TicketAssignee")
  collaborations         TicketCollaborator[]     @relation("UserCollaborations")
  addedCollaborations    TicketCollaborator[]     @relation("AddedByCollaborations")
  replies                Reply[]                  @relation("UserReplies")
  auditLogs              AuditLog[]               @relation("UserAuditLogs")
  acknowledgedAlerts     SlaAlert[]               @relation("UserAlertAcks")
  satisfactions          CustomerSatisfaction[]   @relation("UserSatisfaction")
  recommendationFeedback RecommendationFeedback[] @relation("UserRecommendationFeedback")
  invitations            AgentInvitation[]        @relation("UserInvitations")
  tagActions             TicketTag[]              @relation("UserTagActions")

  // Email digest preferences
  digestEnabled       Boolean          @default(true)
  digestFrequency     DigestFrequency  @default(DAILY)
  digestLastSentAt    DateTime?

  @@map("users")
}

model AgentInvitation {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation("UserInvitations", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("agent_invitations")
}

model Ticket {
  id                         String    @id @default(cuid())
  ticketNumber               Int       @unique @default(autoincrement())
  subject                    String
  description                String
  requesterId                String
  requesterName              String
  requesterEmail             String
  priority                   Priority  @default(MEDIUM)
  category                   Category  @default(QUESTION)
  status                     Status    @default(NEW)
  createdById                String
  primaryAssigneeId          String?
  
  slaTargetMinutes           Int
  slaDueAt                   DateTime?
  slaPausedAt                DateTime?
  slaPausedRemainingSeconds  Int?
  slaCycle                   Int       @default(1)
  
  resolvedAt                 DateTime?
  closedAt                   DateTime?
  archivedAt                 DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  requester              User                  @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  createdBy              User                  @relation("TicketCreator", fields: [createdById], references: [id])
  primaryAssignee        User?                 @relation("TicketAssignee", fields: [primaryAssigneeId], references: [id], onDelete: SetNull)
  collaborators          TicketCollaborator[]
  replies                Reply[]
  auditLogs              AuditLog[]
  slaAlerts              SlaAlert[]
  satisfaction           CustomerSatisfaction?
  recommendationFeedback RecommendationFeedback[]
  tags                   TicketTag[]

  @@index([requesterId, archivedAt, updatedAt(sort: Desc)])
  @@index([primaryAssigneeId, status, archivedAt])
  @@index([status, archivedAt, slaDueAt])
  @@index([archivedAt, createdAt(sort: Desc)])
  @@index([archivedAt, resolvedAt])
  @@index([ticketNumber])
  @@map("tickets")
}

model TicketCollaborator {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  addedById String
  createdAt DateTime @default(now())

  ticket  Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user    User   @relation("UserCollaborations", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User   @relation("AddedByCollaborations", fields: [addedById], references: [id])

  @@unique([ticketId, userId])
  @@index([userId, ticketId])
  @@map("ticket_collaborators")
}

model Reply {
  id             String     @id @default(cuid())
  ticketId       String
  authorId       String?
  authorType     AuthorType @default(AGENT)
  authorName     String
  authorEmail    String
  body           String
  isInternal     Boolean    @default(false)
  attachmentUrl  String?
  attachmentName String?
  attachmentSize Int?
  attachmentType String?
  createdAt      DateTime   @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?  @relation("UserReplies", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt(sort: Asc)])
  @@map("replies")
}

model AuditLog {
  id        String         @id @default(cuid())
  ticketId  String
  actorId   String?
  actorName String
  eventType AuditEventType
  oldValue  Json?
  newValue  Json?
  metadata  Json?
  createdAt DateTime       @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt(sort: Asc)])
  @@map("audit_logs")
}

model SlaAlert {
  id               String         @id @default(cuid())
  ticketId         String
  type             SlaAlertType
  status           SlaAlertStatus @default(ACTIVE)
  breachCycle      Int            @default(1)
  acknowledgedById String?
  acknowledgedAt   DateTime?
  createdAt        DateTime       @default(now())

  ticket         Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  acknowledgedBy User?  @relation("UserAlertAcks", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@unique([ticketId, breachCycle])
  @@index([ticketId, status])
  @@map("sla_alerts")
}

model CustomerSatisfaction {
  id        String   @id @default(cuid())
  ticketId  String   @unique
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation("UserSatisfaction", fields: [userId], references: [id], onDelete: Restrict)

  @@index([rating])
  @@map("customer_satisfactions")
}

model KnowledgeArticle {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  category    Category @default(QUESTION)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, isPublished])
  @@map("kb_articles")
}

model RecommendationFeedback {
  id              String   @id @default(cuid())
  targetTicketId  String
  sourceType      String   // "TICKET" | "KB"
  sourceId        String
  similarityScore Float
  actionTaken     String   // "INSERTED" | "VIEWED" | "DISMISSED"
  agentId         String?
  createdAt       DateTime @default(now())

  targetTicket    Ticket   @relation(fields: [targetTicketId], references: [id], onDelete: Cascade)
  agent           User?    @relation("UserRecommendationFeedback", fields: [agentId], references: [id], onDelete: SetNull)

  @@index([targetTicketId])
  @@index([agentId])
  @@map("recommendation_feedback")
}

model TagGroup {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  color        String   @default("#6B7280")
  isExclusive  Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tags Tag[]

  @@index([displayOrder])
  @@map("tag_groups")
}

model Tag {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  color      String    @default("#6B7280")
  groupId    String?
  usageCount Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  group   TagGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  tickets TicketTag[]

  @@unique([groupId, name])
  @@index([slug])
  @@index([groupId, usageCount(sort: Desc)])
  @@map("tags")
}

model TicketTag {
  id        String   @id @default(cuid())
  ticketId  String
  tagId     String
  addedById String?
  createdAt DateTime @default(now())

  ticket  Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  addedBy User?  @relation("UserTagActions", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([ticketId, tagId])
  @@index([ticketId])
  @@index([tagId])
  @@map("ticket_tags")
}
