# PostgreSQL Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ticketing?schema=public"

# Session Secret for Signed HTTP-only Cookie Authentication (minimum 32 characters)
SESSION_SECRET="support-ticketing-super-secret-key-change-in-production-minimum-32-chars-long"

# Frontend Origin for CORS
FRONTEND_URL="http://localhost:3000"

# Server Environment & Port
NODE_ENV="development"
PORT=3001
