# Supabase Managed PostgreSQL Database URLs
# 1. Pooled Connection URL (Transaction Mode via Supavisor on Port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15&pool_timeout=30"

# 2. Direct / Session Connection URL (Port 5432) - for schema migrations & DDL
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Session Secret for Signed HTTP-only Cookie Authentication (minimum 32 characters)
SESSION_SECRET="your-secure-random-32-plus-character-secret-for-jwt-signing"

# Frontend Origin for CORS
FRONTEND_URL="http://localhost:3000"

# Server Environment & Port
NODE_ENV="development"
PORT=3001

# AI & Semantic Search (Optional)
# 1. Google Gemini API (100% Free - Get key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# 2. OpenAI API (Optional alternative)
OPENAI_API_KEY=""

# Note: If no API key is provided, or if the rate limit is reached (HTTP 429),
# the system automatically and gracefully falls back to the built-in deterministic
# 1536-dimensional vector generator. Zero crashes, zero external dependencies required.

# Transactional Email & Queue Digests (Optional - Resend API)
# Get a free API key at https://resend.com
RESEND_API_KEY=""
RESEND_FROM="Busy Infotech Support <onboarding@resend.dev>"


